---
import Layout from '../layouts/Layout.astro';
import GameCard from '../components/GameCard.astro';
import PageHero from '../components/PageHero.astro';
import EmptyState from '../components/EmptyState.astro';
import { getDatabase } from '../lib/db';
import { getAllCategories, getAllGames, getAllPublishers } from '../lib/games';

export const prerender = true;

const categories = await getAllCategories(getDatabase());
const publishers = await getAllPublishers(getDatabase());
const games = await getAllGames(getDatabase());
---

<Layout title="Tailspin Toys - Crowdfunding your new favorite game!">
  <div class="py-8">
    <PageHero
      title="Welcome to Tailspin Toys"
      subtitle="Find your next game! And maybe even back one! Explore our collection!"
    />

    <div class="mb-8 rounded-2xl border border-slate-700 bg-slate-800/60 p-6 shadow-lg" data-testid="game-filters">
      <form method="get" class="space-y-5">
        <fieldset>
          <legend class="mb-3 text-sm font-medium uppercase tracking-wide text-slate-300">Filter by category</legend>
          <div class="flex flex-wrap gap-3">
            {categories.map((category) => (
              <label
                class="inline-flex items-center gap-2 rounded-full border border-slate-600 bg-slate-900 px-3 py-2 text-sm text-slate-200 transition-colors hover:border-blue-500/60 focus-within:ring-2 focus-within:ring-blue-500 focus-within:outline-none"
                data-testid={`category-filter-${category.id}`}
              >
                <input
                  type="checkbox"
                  name="category"
                  value={category.id}
                  class="h-4 w-4 rounded border-slate-600 bg-slate-900 text-blue-500 focus:ring-2 focus:ring-blue-500 focus:outline-none"
                  data-testid={`category-filter-checkbox-${category.id}`}
                />
                <span>{category.name}</span>
              </label>
            ))}
          </div>
        </fieldset>

        <div class="flex flex-col gap-3 sm:flex-row sm:items-end sm:justify-between">
          <label class="block w-full sm:max-w-xs" for="publisher-filter">
            <span class="mb-2 block text-sm font-medium uppercase tracking-wide text-slate-300">Filter by publisher</span>
            <select
              id="publisher-filter"
              name="publisher"
              class="w-full rounded-lg border border-slate-600 bg-slate-900 px-3 py-2 text-slate-100 shadow-sm focus:ring-2 focus:ring-blue-500 focus:outline-none"
              data-testid="publisher-filter-select"
              aria-label="Filter by publisher"
            >
              <option value="">All publishers</option>
              {publishers.map((publisher) => (
                <option value={publisher.id}>
                  {publisher.name}
                </option>
              ))}
            </select>
          </label>

          <div class="flex items-center gap-3">
            <a
              href="/"
              class="inline-flex items-center rounded-lg border border-slate-600 px-4 py-2 text-sm font-medium text-slate-200 hover:bg-slate-700 focus:ring-2 focus:ring-blue-500 focus:outline-none"
              data-testid="clear-filters-button"
            >
              Clear filters
            </a>
            <button
              type="submit"
              class="inline-flex items-center rounded-lg bg-blue-600 px-4 py-2 text-sm font-medium text-white hover:bg-blue-500 focus:ring-2 focus:ring-blue-500 focus:outline-none"
              data-testid="apply-filters-button"
            >
              Apply filters
            </button>
          </div>
        </div>
      </form>
    </div>

    <div>
      <h2 class="text-2xl font-medium mb-6 text-slate-100">Featured Games</h2>

      {games.length === 0 ? (
        <EmptyState text="No games available at the moment." />
      ) : (
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6" data-testid="games-grid">
          {games.map((game) => <GameCard game={game} />)}
        </div>
      )}
      <div class="hidden" data-testid="filtered-empty-state">
        <EmptyState text="No games match the current filters." />
      </div>
    </div>
  </div>
</Layout>

<script>
    const form = document.querySelector<HTMLFormElement>('[data-testid="game-filters"] form');
    const cards = [...document.querySelectorAll<HTMLElement>('[data-testid="game-card"]')];
    const grid = document.querySelector<HTMLElement>('[data-testid="games-grid"]');
    const emptyState = document.querySelector<HTMLElement>('[data-testid="filtered-empty-state"]');

    if (form && grid && emptyState) {
        const categoryInputs = [...form.querySelectorAll<HTMLInputElement>('input[name="category"]')];
        const publisherInput = form.querySelector<HTMLSelectElement>('select[name="publisher"]');

        const applyFilters = (): void => {
            const selectedCategories = new Set(
                categoryInputs.filter((input) => input.checked).map((input) => input.value),
            );
            const selectedPublisher = publisherInput?.value ?? '';
            let visibleCards = 0;

            cards.forEach((card) => {
                const matchesCategory =
                    selectedCategories.size === 0 ||
                    selectedCategories.has(card.dataset.gameCategoryId ?? '');
                const matchesPublisher =
                    selectedPublisher === '' ||
                    card.dataset.gamePublisherId === selectedPublisher;
                const isVisible = matchesCategory && matchesPublisher;

                card.classList.toggle('hidden', !isVisible);
                visibleCards += isVisible ? 1 : 0;
            });

            grid.classList.toggle('hidden', visibleCards === 0);
            emptyState.classList.toggle('hidden', visibleCards !== 0);
        };

        const syncUrl = (): void => {
            const params = new URLSearchParams();
            categoryInputs.filter((input) => input.checked).forEach((input) => {
                params.append('category', input.value);
            });
            if (publisherInput?.value) {
                params.set('publisher', publisherInput.value);
            }

            const query = params.toString();
            window.history.replaceState(null, '', query ? `/?${query}` : '/');
        };

        form.addEventListener('submit', (event) => {
            event.preventDefault();
            syncUrl();
            applyFilters();
        });
        form.addEventListener('change', applyFilters);

        const params = new URLSearchParams(window.location.search);
        const selectedCategories = new Set(params.getAll('category'));
        categoryInputs.forEach((input) => {
            input.checked = selectedCategories.has(input.value);
        });
        if (publisherInput) {
            publisherInput.value = params.get('publisher') ?? '';
        }
        applyFilters();
    }
</script>
